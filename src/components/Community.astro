---

<section id="community">
  <div class="wrap">
    <h2 class="section-title">Community</h2>
    <p class="section-sub">
      A room of traders who read before they react.
    </p>

    <div class="card community-card">
      <blockquote>
        Built by <em>Lemy</em>. For the trader who wants the work to speak
        louder than the noise.
      </blockquote>
      <div class="links">
        <a href="https://web.facebook.com/lemuelowusuansah" target="_blank" rel="noopener noreferrer">Facebook</a>
        <a href="https://github.com/LemuelOwusuAnsah" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>

    <p class="soon">Private community opening soon. Follow for the invite.</p>
  </div>
</section>

<style>
  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 48px 36px;
    border-radius: var(--radius);
  }

  .community-card blockquote {
    font-size: clamp(20px, 3vw, 30px);
    font-weight: 300;
    letter-spacing: -0.5px;
    line-height: 1.4;
    max-width: 760px;
    color: var(--text-soft);
    margin-bottom: 28px;
  }

  .community-card blockquote em {
    color: var(--gold);
    font-style: normal;
    font-weight: 600;
  }

  .links {
    display: flex;
    gap: 24px;
  }

  .links a {
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-mute);
    transition: color 0.2s;
  }

  .links a:hover {
    color: var(--gold);
  }

  .soon {
    margin-top: 36px;
    font-size: 13px;
    color: var(--text-dim);
  }
</style>
